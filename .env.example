# Ragaa Authentication Environment Variables
# Duplicate this file to .env.local for local Next.js development,
# or add these variables to your Vercel Project Settings > Environment Variables.

# Next.js Client Public Configuration (Required for live Firebase Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=raaga-kannada.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=raaga-kannada
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=raaga-kannada.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Cloud Functions & Token Minting Secrets
RAGAA_AUTH_SECRET=generate_a_cryptographically_secure_random_string_here

# Email Delivery Provider (SendGrid / Postmark for production Cloud Functions email codes)
SENDGRID_API_KEY=SG.your_sendgrid_key_here
MAIL_FROM_ADDRESS=auth@ragaa.music

# NOTE: If these variables are omitted, Ragaa will automatically run in
# Demo Mode ("Demo mode: any 6-digit code works"), allowing safe UI and flow testing.
