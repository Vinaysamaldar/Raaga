# Ragaa Firebase & Authentication Configuration
# Copy this file to .env or set environment variables in your deployment host (Vercel / Firebase Hosting)

# Firebase Web App Client Configuration
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=raaga-kannada.firebaseapp.com
FIREBASE_PROJECT_ID=raaga-kannada
FIREBASE_STORAGE_BUCKET=raaga-kannada.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Cloud Functions & Security
RAGAA_AUTH_SECRET=generate_a_cryptographically_secure_random_string_here

# Third-party Mail Provider (Optional for Cloud Functions production dispatch)
SENDGRID_API_KEY=SG.your_sendgrid_key_here
MAIL_FROM_ADDRESS=auth@ragaa.music
