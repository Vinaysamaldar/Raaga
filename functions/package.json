{
  "name": "ragaa-auth-functions",
  "description": "Firebase Cloud Functions for Ragaa Kannada Music App Passwordless Authentication",
  "version": "1.0.0",
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
